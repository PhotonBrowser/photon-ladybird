+<!DOCTYPE html>
+<style>
+    @keyframes spin {
+        to { transform: rotate(1turn); }
+    }
+
+    #animated {
+        width: 20px;
+        height: 20px;
+        animation: spin 1s linear 5s infinite;
+    }
+</style>
+<div id="animated"></div>
+<script src="../../include.js"></script>
+<script>
+    function nextTask() {
+        const { promise, resolve } = Promise.withResolvers();
+        const channel = new MessageChannel();
+        channel.port1.onmessage = resolve;
+        channel.port2.postMessage(null);
+        return promise;
+    }
+
+    asyncTest(async done => {
+        internals.setManualRenderingOpportunities(true);
+        await nextTask();
+        animated.getAnimations();
+
+        const firstFrameTime = performance.now();
+        internals.injectRenderingOpportunity(firstFrameTime);
+        await nextTask();
+        internals.injectRenderingOpportunity(firstFrameTime + 16);
+        await nextTask();
+
+        await new Promise(resolve => setTimeout(resolve, 100));
+        document.addEventListener("animationstart", () => {});
+        const synchronizedTimelineTime = document.timeline.currentTime;
+        let renderingCallbackTime;
+        requestAnimationFrame(timestamp => renderingCallbackTime = timestamp);
+
+        // Simulate a compositor opportunity queued before listener registration but delivered afterward.
+        internals.injectRenderingOpportunity(firstFrameTime + 17);
+        await nextTask();
+        internals.setManualRenderingOpportunities(false);
+
+        println(`rendering timestamp is not behind the observed document timeline: ${renderingCallbackTime >= synchronizedTimelineTime}`);
+        done();
+    });
+</script>
