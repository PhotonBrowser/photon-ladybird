+void EventLoop::ensure_rendering_timestamp_at_least(HighResolutionTime::DOMHighResTimeStamp timestamp)
+{
+    // INTEROP: Compositor-provided display timestamps can arrive late or out of order. Also keep them from going
+    //          behind a timeline that was synchronized directly while processing an event listener.
+    auto now = HighResolutionTime::unsafe_shared_current_time();
+    m_last_render_opportunity_time = max(m_last_render_opportunity_time, min(timestamp, now));
+}
