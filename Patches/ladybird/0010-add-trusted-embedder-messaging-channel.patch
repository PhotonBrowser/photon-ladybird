+#include <WebContent/TrustedEmbedderMessagingClientEndpoint.h>
+#include <WebContent/TrustedEmbedderMessagingServerEndpoint.h>
+
+namespace WebContent {
+
+class TrustedEmbedderMessagingConnection final
+    : public IPC::ConnectionFromClient<TrustedEmbedderMessagingClientEndpoint, TrustedEmbedderMessagingServerEndpoint> {
+public:
+    static ErrorOr<NonnullRefPtr<TrustedEmbedderMessagingConnection>> connect(IPC::TransportHandle, Web::DOM::Document&, u64 generation);
+    virtual ~TrustedEmbedderMessagingConnection() override;
+
+    void visit_edges(JS::Cell::Visitor&);
+    void post_message_from_document(String type, JsonValue payload);
+    JsonArray take_messages();
+    bool is_active() const { return m_is_active; }
+    Web::DOM::Document const& document() const { return m_document; }
+    u64 generation() const { return m_generation; }
+
+private:
+    TrustedEmbedderMessagingConnection(NonnullOwnPtr<IPC::Transport>, Web::DOM::Document&, u64 generation);
+    virtual void die() override;
+    void revoke();
+    virtual void send_message(u64 generation, String type, JsonValue payload) override;
+
+    GC::Ref<Web::DOM::Document> m_document;
+    u64 m_generation { 0 };
+    struct QueuedMessage {
+        String type;
+        JsonValue payload;
+        size_t serialized_size { 0 };
+    };
+    Vector<QueuedMessage> m_queued_messages;
+    size_t m_queued_message_bytes { 0 };
+    bool m_is_active { true };
+};
+
+}
