+
+ErrorOr<void> PageClient::connect_trusted_embedder_messaging(Utf16String const& navigation_id, u64 generation, IPC::TransportHandle handle)
+{
+    if (generation <= m_trusted_embedder_messaging_generation
+        || !m_last_completed_top_level_navigation_id.has_value()
+        || *m_last_completed_top_level_navigation_id != navigation_id
+        || !page().has_local_traversable())
+        return Error::from_string_literal("Trusted embedder messaging authorization is stale");
+
+    auto active_document = page().local_traversable()->active_document();
+    if (!active_document || !active_document->window() || !active_document->is_fully_active())
+        return Error::from_string_literal("No active top-level document for trusted embedder messaging");
+
+    m_trusted_embedder_messaging.clear();
+    m_trusted_embedder_messaging = TRY(TrustedEmbedderMessagingConnection::connect(move(handle), *active_document, generation));
+    m_trusted_embedder_messaging_generation = generation;
+    return { };
+}
+
+bool PageClient::send_trusted_embedder_message(String const& type, JsonValue payload)
+{
+    if (!m_trusted_embedder_messaging || !m_trusted_embedder_messaging->is_active() || !page().has_local_traversable())
+        return false;
+    auto active_document = page().local_traversable()->active_document();
+    if (!active_document || active_document.ptr() != &m_trusted_embedder_messaging->document())
+        return false;
+    m_trusted_embedder_messaging->post_message_from_document(type, move(payload));
+    return true;
+}
+
+String PageClient::take_trusted_embedder_messages(Web::DOM::Document const& document)
+{
+    if (!m_trusted_embedder_messaging || !m_trusted_embedder_messaging->is_active() || !page().has_local_traversable())
+        return "[]"_string;
+    auto active_document = page().local_traversable()->active_document();
+    if (!active_document || active_document.ptr() != &document || active_document.ptr() != &m_trusted_embedder_messaging->document())
+        return "[]"_string;
+    return m_trusted_embedder_messaging->take_messages().serialized();
 }
 
