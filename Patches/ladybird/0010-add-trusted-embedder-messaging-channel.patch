@@ -0,0 +1,140 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/JsonArray.h>
+#include <AK/JsonObject.h>
+#include <AK/NeverDestroyed.h>
+#include <LibGC/Heap.h>
+#include <LibJS/Runtime/PropertyAttributes.h>
+#include <LibWeb/Bindings/PlatformObject.h>
+#include <LibWeb/Bindings/Wrappable.h>
+#include <LibWeb/Bindings/WrapperWorld.h>
+#include <LibWeb/DOM/CustomEvent.h>
+#include <LibWeb/DOM/Document.h>
+#include <LibWeb/DOM/Event.h>
+#include <LibWeb/HTML/LocalNavigable.h>
+#include <LibWeb/HTML/Scripting/Environments.h>
+#include <LibWeb/HTML/Scripting/TemporaryExecutionContext.h>
+#include <LibWeb/HTML/Window.h>
+#include <LibWeb/Internals/TrustedEmbedderMessaging.h>
+#include <LibWeb/WebDriver/JSON.h>
+#include <WebContent/TrustedEmbedderMessagingConnection.h>
+
+namespace WebContent {
+
+static JS::PropertyKey const& embedder_messaging_property()
+{
+    static NeverDestroyed<JS::PropertyKey> property { "embedderMessaging"_utf16_fly_string };
+    return *property;
+}
+
+static FlyString const& embedder_message_event()
+{
+    static NeverDestroyed<FlyString> event { "TrustedEmbedderMessageAvailable"_fly_string };
+    return *event;
+}
+
+ErrorOr<NonnullRefPtr<TrustedEmbedderMessagingConnection>> TrustedEmbedderMessagingConnection::connect(IPC::TransportHandle handle, Web::DOM::Document& document, u64 generation)
+{
+    auto transport = TRY(handle.create_transport());
+    return adopt_ref(*new TrustedEmbedderMessagingConnection(move(transport), document, generation));
+}
+
+TrustedEmbedderMessagingConnection::TrustedEmbedderMessagingConnection(NonnullOwnPtr<IPC::Transport> transport, Web::DOM::Document& document, u64 generation)
+    : IPC::ConnectionFromClient<TrustedEmbedderMessagingClientEndpoint, TrustedEmbedderMessagingServerEndpoint>(*this, move(transport), 1)
+    , m_document(document)
+    , m_generation(generation)
+{
+    auto& realm = m_document->relevant_settings_object().realm();
+    auto& window = Web::HTML::relevant_window(realm.global_object());
+    JS::PropertyAttributes attributes = JS::default_attributes;
+    attributes.set_writable(false);
+    realm.global_object().define_direct_property(embedder_messaging_property(), Web::Bindings::wrap(Web::Bindings::host_defined_wrapper_world(realm), realm, Web::Internals::TrustedEmbedderMessaging::create(window)), attributes);
+}
+
+TrustedEmbedderMessagingConnection::~TrustedEmbedderMessagingConnection()
+{
+    revoke();
+}
+
+void TrustedEmbedderMessagingConnection::die()
+{
+    revoke();
+}
+
+void TrustedEmbedderMessagingConnection::revoke()
+{
+    if (!m_is_active)
+        return;
+    m_is_active = false;
+    m_queued_messages.clear();
+    m_queued_message_bytes = 0;
+    if (m_document->window())
+        (void)m_document->relevant_settings_object().realm().global_object().internal_delete(embedder_messaging_property());
+}
+
+void TrustedEmbedderMessagingConnection::visit_edges(JS::Cell::Visitor& visitor)
+{
+    visitor.visit(m_document);
+}
+
+void TrustedEmbedderMessagingConnection::post_message_from_document(String type, JsonValue payload)
+{
+    if (!m_is_active || !m_document->browsing_context() || !m_document->is_fully_active())
+        return;
+    auto const serialized_payload = payload.serialized();
+    if (type.is_empty() || type.bytes().size() > 128 || serialized_payload.bytes().size() > 64 * 1024)
+        return;
+    async_received_message(m_generation, move(type), move(payload));
+}
+
+void TrustedEmbedderMessagingConnection::send_message(u64 generation, String type, JsonValue payload)
+{
+    if (!m_is_active || generation != m_generation || !m_document->browsing_context() || !m_document->is_fully_active())
+        return;
+    auto navigable = m_document->navigable();
+    if (!navigable || !navigable->is_top_level_traversable())
+        return;
+    auto local_navigable = as_if<Web::HTML::LocalNavigable>(navigable.ptr());
+    if (!local_navigable || local_navigable->active_document().ptr() != m_document.ptr())
+        return;
+    auto serialized_payload = payload.serialized();
+    if (type.is_empty() || type.bytes().size() > 128 || serialized_payload.bytes().size() > 64 * 1024)
+        return;
+
+    auto serialized_size = type.bytes().size() + serialized_payload.bytes().size();
+    constexpr size_t maximum_queued_messages = 64;
+    constexpr size_t maximum_queued_message_bytes = 1024 * 1024;
+    if (serialized_size > maximum_queued_message_bytes)
+        return;
+    while (!m_queued_messages.is_empty()
+        && (m_queued_messages.size() >= maximum_queued_messages || m_queued_message_bytes + serialized_size > maximum_queued_message_bytes)) {
+        m_queued_message_bytes -= m_queued_messages.first().serialized_size;
+        m_queued_messages.remove(0);
+    }
+    m_queued_message_bytes += serialized_size;
+    m_queued_messages.append({ move(type), move(payload), serialized_size });
+
+    auto& realm = m_document->relevant_settings_object().realm();
+    Web::HTML::TemporaryExecutionContext context { realm };
+    m_document->dispatch_event(Web::DOM::Event::create(realm.global_object(), embedder_message_event()));
+}
+
+JsonArray TrustedEmbedderMessagingConnection::take_messages()
+{
+    JsonArray messages;
+    for (auto& queued_message : m_queued_messages) {
+        JsonObject message;
+        message.set("type"sv, move(queued_message.type));
+        message.set("payload"sv, move(queued_message.payload));
+        MUST(messages.append(move(message)));
+    }
+    m_queued_messages.clear();
+    m_queued_message_bytes = 0;
+    return messages;
+}
+
+}
