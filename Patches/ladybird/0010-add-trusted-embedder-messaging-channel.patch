+ErrorOr<void> ViewImplementation::enable_trusted_embedder_messaging(TrustedEmbedderMessageCallback callback, TrustedEmbedderMessagingLimits limits)
+{
+    if (!callback)
+        return Error::from_string_literal("Trusted embedder messaging requires an inbound callback");
+    if (m_trusted_embedder_messaging_armed)
+        return Error::from_string_literal("Trusted embedder messaging is already armed for a load");
+
+    m_trusted_embedder_message_callback = move(callback);
+    m_trusted_embedder_messaging_limits.maximum_serialized_message_size = min(limits.maximum_serialized_message_size, 64 * 1024);
+    m_trusted_embedder_messaging_limits.maximum_type_size = min(limits.maximum_type_size, 128);
+    m_trusted_embedder_messaging_armed = true;
+    m_trusted_embedder_messaging_navigation_id.clear();
+    return { };
+}
+
+ErrorOr<void> ViewImplementation::send_trusted_embedder_message(TrustedEmbedderMessage const& message)
+{
+    if (!m_trusted_embedder_messaging_channel)
+        return Error::from_string_literal("Trusted embedder messaging is not connected");
+    return m_trusted_embedder_messaging_channel->send(message);
+}
+
+void ViewImplementation::disable_trusted_embedder_messaging()
+{
+    m_trusted_embedder_messaging_armed = false;
+    m_trusted_embedder_messaging_navigation_id.clear();
+    m_trusted_embedder_message_callback = { };
+    m_trusted_embedder_messaging_channel = nullptr;
+}
+
+ErrorOr<void> ViewImplementation::connect_trusted_embedder_messaging(Utf16String const& navigation_id, WebContentPage& page)
+{
+    if (!m_trusted_embedder_messaging_navigation_id.has_value() || *m_trusted_embedder_messaging_navigation_id != navigation_id)
+        return { };
+
+    m_trusted_embedder_messaging_navigation_id.clear();
+    if (!m_trusted_embedder_message_callback)
+        return Error::from_string_literal("Trusted embedder messaging callback was cleared before document activation");
+
+    auto generation = ++m_trusted_embedder_messaging_generation;
+    m_trusted_embedder_messaging_channel = TRY(TrustedEmbedderMessagingChannel::create(
+        client(), page.id(), navigation_id, generation,
+        move(m_trusted_embedder_message_callback), m_trusted_embedder_messaging_limits));
+    return { };
+}
