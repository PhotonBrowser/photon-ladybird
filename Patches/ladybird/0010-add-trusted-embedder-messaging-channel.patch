+
+namespace WebView {
+
+class WebContentClient;
+
+struct TrustedEmbedderMessage {
+    String type;
+    JsonValue payload;
+};
+
+using TrustedEmbedderMessageCallback = Function<void(TrustedEmbedderMessage)>;
+
+struct TrustedEmbedderMessagingLimits {
+    size_t maximum_serialized_message_size { 64 * 1024 };
+    size_t maximum_type_size { 128 };
+};
+
+class WEBVIEW_API TrustedEmbedderMessagingChannel final
+    : public IPC::ConnectionToServer<TrustedEmbedderMessagingClientEndpoint, TrustedEmbedderMessagingServerEndpoint>
+    , public TrustedEmbedderMessagingClientEndpoint {
+public:
+    static ErrorOr<NonnullRefPtr<TrustedEmbedderMessagingChannel>> create(
+        WebContentClient&, Compositing::PageId, Utf16String navigation_id, u64 generation,
+        TrustedEmbedderMessageCallback, TrustedEmbedderMessagingLimits);
+    virtual ~TrustedEmbedderMessagingChannel() override;
+
+    ErrorOr<void> send(TrustedEmbedderMessage const&);
+
+private:
+    TrustedEmbedderMessagingChannel(NonnullOwnPtr<IPC::Transport>, u64, TrustedEmbedderMessageCallback, TrustedEmbedderMessagingLimits);
+    virtual void die() override;
+    virtual void received_message(u64 generation, String type, JsonValue payload) override;
+
+    u64 m_generation { 0 };
+    TrustedEmbedderMessageCallback m_callback;
+    TrustedEmbedderMessagingLimits m_limits;
+};
+
+}
