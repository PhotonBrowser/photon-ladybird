@@ -0,0 +1,82 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibWeb/DOM/Document.h>
+#include <LibWeb/HTML/LocalNavigable.h>
+#include <LibWeb/HTML/Scripting/Environments.h>
+#include <LibWeb/HTML/Window.h>
+#include <LibWeb/Internals/TrustedEmbedderMessaging.h>
+#include <LibWeb/Page/Page.h>
+#include <LibWeb/WebDriver/JSON.h>
+
+namespace Web::Internals {
+
+GC_DEFINE_ALLOCATOR(TrustedEmbedderMessaging);
+
+GC::Ref<TrustedEmbedderMessaging> TrustedEmbedderMessaging::create(HTML::Window& window)
+{
+    return GC::Heap::the().allocate<TrustedEmbedderMessaging>(window);
+}
+
+TrustedEmbedderMessaging::TrustedEmbedderMessaging(HTML::Window& window)
+    : InternalsBase(window)
+{
+}
+
+TrustedEmbedderMessaging::~TrustedEmbedderMessaging() = default;
+
+WebIDL::ExceptionOr<void> TrustedEmbedderMessaging::post_message(Utf16String const& type, JS::Value payload)
+{
+    auto& authorized_document = window().associated_document();
+    auto& caller_settings = HTML::incumbent_settings_object();
+    auto* caller_window = HTML::window_from_global_object(caller_settings.global_object());
+    if (!caller_window || &caller_window->associated_document() != &authorized_document)
+        return WebIDL::SecurityError::create("Trusted embedder messages may only be sent by their authorized document"_utf16);
+
+    auto navigable = authorized_document.navigable();
+    if (!navigable || !navigable->is_top_level_traversable() || !authorized_document.is_fully_active())
+        return WebIDL::SecurityError::create("The authorized embedder document is no longer active"_utf16);
+
+    auto local_navigable = as_if<HTML::LocalNavigable>(navigable.ptr());
+    if (!local_navigable || local_navigable->active_document().ptr() != &authorized_document)
+        return WebIDL::SecurityError::create("The authorized embedder document is no longer active"_utf16);
+
+    auto browsing_context = authorized_document.browsing_context();
+    if (!browsing_context)
+        return WebIDL::SecurityError::create("The authorized embedder document has no browsing context"_utf16);
+    auto serialized_payload = Web::WebDriver::json_clone(*browsing_context, payload);
+    if (serialized_payload.is_error())
+        return WebIDL::DataCloneError::create("Embedder message payload must be JSON serializable"_utf16);
+    auto type_utf8 = type.to_utf8();
+    auto serialized_payload_json = serialized_payload.value().serialized();
+    if (type_utf8.is_empty() || type_utf8.bytes().size() > 128 || serialized_payload_json.bytes().size() > 64 * 1024)
+        return WebIDL::DataCloneError::create("Embedder message exceeds the size limit"_utf16);
+
+    if (!page().client().send_trusted_embedder_message(type_utf8, serialized_payload.release_value()))
+        return WebIDL::SecurityError::create("The trusted embedder messaging channel is no longer active"_utf16);
+    return { };
+}
+
+WebIDL::ExceptionOr<Utf16String> TrustedEmbedderMessaging::receive_messages()
+{
+    auto& authorized_document = window().associated_document();
+    auto& caller_settings = HTML::incumbent_settings_object();
+    auto* caller_window = HTML::window_from_global_object(caller_settings.global_object());
+    if (!caller_window || &caller_window->associated_document() != &authorized_document)
+        return WebIDL::SecurityError::create("Embedder messages may only be read by their authorized document"_utf16);
+
+    auto navigable = authorized_document.navigable();
+    if (!navigable || !navigable->is_top_level_traversable() || !authorized_document.is_fully_active())
+        return WebIDL::SecurityError::create("The authorized embedder document is no longer active"_utf16);
+    auto local_navigable = as_if<HTML::LocalNavigable>(navigable.ptr());
+    if (!local_navigable || local_navigable->active_document().ptr() != &authorized_document)
+        return WebIDL::SecurityError::create("The authorized embedder document is no longer active"_utf16);
+
+    auto messages = page().client().take_trusted_embedder_messages(authorized_document);
+    return Utf16String::from_utf8_without_validation(messages.bytes_as_string_view());
+}
+
+}
