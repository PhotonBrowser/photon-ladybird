new file mode 100644
index 00000000..7fbc19f4
--- /dev/null
+++ b/Libraries/LibWebView/TrustedEmbedderMessaging.cpp
@@ -0,0 +1,67 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibIPC/Transport.h>
+#include <LibIPC/TransportHandle.h>
+#include <LibWebView/TrustedEmbedderMessaging.h>
+#include <LibWebView/WebContentClient.h>
+
+namespace WebView {
+
+ErrorOr<NonnullRefPtr<TrustedEmbedderMessagingChannel>> TrustedEmbedderMessagingChannel::create(
+    WebContentClient& client, Compositing::PageId page_id, Utf16String navigation_id, u64 generation,
+    TrustedEmbedderMessageCallback callback, TrustedEmbedderMessagingLimits limits)
+{
+    auto paired = TRY(IPC::Transport::create_paired());
+    auto channel = adopt_ref(*new TrustedEmbedderMessagingChannel(move(paired.local), generation, move(callback), limits));
+    client.async_connect_trusted_embedder_messaging(page_id, move(navigation_id), generation, move(paired.remote_handle));
+    return channel;
+}
+
+TrustedEmbedderMessagingChannel::TrustedEmbedderMessagingChannel(
+    NonnullOwnPtr<IPC::Transport> transport, u64 generation, TrustedEmbedderMessageCallback callback, TrustedEmbedderMessagingLimits limits)
+    : IPC::ConnectionToServer<TrustedEmbedderMessagingClientEndpoint, TrustedEmbedderMessagingServerEndpoint>(*this, move(transport))
+    , m_generation(generation)
+    , m_callback(move(callback))
+    , m_limits(limits)
+{
+}
+
+TrustedEmbedderMessagingChannel::~TrustedEmbedderMessagingChannel() = default;
+
+ErrorOr<void> TrustedEmbedderMessagingChannel::send(TrustedEmbedderMessage const& message)
+{
+    if (!m_callback)
+        return Error::from_string_literal("Trusted embedder messaging channel is disconnected");
+    if (message.type.is_empty() || message.type.bytes().size() > m_limits.maximum_type_size)
+        return Error::from_string_literal("Trusted embedder message type is invalid");
+    auto serialized_payload = message.payload.serialized();
+    if (serialized_payload.bytes().size() > m_limits.maximum_serialized_message_size)
+        return Error::from_string_literal("Trusted embedder message exceeds the size limit");
+
+    async_send_message(m_generation, message.type, message.payload);
+    return { };
+}
+
+void TrustedEmbedderMessagingChannel::die()
+{
+    m_callback = { };
+}
+
+void TrustedEmbedderMessagingChannel::received_message(u64 generation, String type, JsonValue payload)
+{
+    if (generation != m_generation || !m_callback)
+        return;
+    if (type.is_empty() || type.bytes().size() > m_limits.maximum_type_size)
+        return;
+    auto serialized_payload = payload.serialized();
+    if (serialized_payload.bytes().size() > m_limits.maximum_serialized_message_size)
+        return;
+
+    m_callback({ move(type), move(payload) });
+}
+
+}
