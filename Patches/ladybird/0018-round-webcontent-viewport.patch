+void WebContentView::set_viewport_corner_radius(int radius)
+{
+    if (radius < 0)
+        radius = 0;
+    if (m_viewport_corner_radius == radius)
+        return;
+
+    m_viewport_corner_radius = radius;
+    setAttribute(Qt::WA_TranslucentBackground, radius > 0);
+    setAttribute(Qt::WA_NoSystemBackground, radius > 0);
+    update();
+}
